Host localhost
	HostName localhost
	StrictHostKeyChecking no
	UserKnownHostsFile=/dev/null

Host hades
	user gabe
	ForwardAgent yes

Host l33tnasx
	User leet
	IdentityFile ~/.ssh/id_ed25519

Host kronos
	User gabe
	ForwardAgent yes

{{- if or (eq .chezmoi.hostname "melinoe") (eq .chezmoi.hostname "macaria") }}
Host clash-build
	HostName {{ (rbwFields "Clash Build Host").URL.value }}
	User {{ (rbwFields "Clash Build Host").username.value }}
Host clash-qa
	HostName {{ (rbwFields "Clash QA").URL.value }}
Host clash-staging
	HostName {{ (rbwFields "Clash Staging").URL.value }}
Host clash-prod
	HostName {{ (rbwFields "Clash Prod").URL.value }}
Host clash-atlassian
	HostName {{ (rbwFields "Clash Atlassian").URL.value }}
Host clash-website
	HostName {{ (rbwFields "Clash Website VM").URL.value }}
	User {{ (rbwFields "Clash Website VM").username.value }}
Host clash-bots
	HostName {{ (rbwFields "Clash Bots").URL.value }}
Host clash-support
	HostName {{ (rbwFields "Clash Support VM").URL.value }}
Host clash-cogsink
	HostName {{ (rbwFields "Clash Cogs.ink VM").URL.value }}
	User {{ (rbwFields "Clash Cogs.ink VM").username.value }}

Host *.corpclash.com
	ForwardAgent yes
{{- end }}

Host *
	SetEnv TERM=xterm-256color # sorry kitty
